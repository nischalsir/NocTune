<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later draw the splash screen themselves: NocTune's
         icon, masked to a circle, on its background. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/noc_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
    <!-- Behind the Flutter UI once it starts: the same colour, so there is
         no flash between the splash and the first frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/noc_splash_background</item>
    </style>
</resources>
